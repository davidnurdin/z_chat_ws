        if (now < suppressClicksUntil) {
          return;
        }
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        const user = (item.textContent || '').trim();
        if(!user) return;

        // Double-click detection on same user within DOUBLE_DELAY
        if (lastClickUser === user && (now - lastClickTime) <= DOUBLE_DELAY) {
          // It's a double click: cancel pending single, reset state, and open private
          if (singleClickTimer){ clearTimeout(singleClickTimer); singleClickTimer = null; }
          lastClickUser = null;
          lastClickTime = 0;
          handleDoubleClick(user);
          return;
        }
        // Otherwise, set up single-click with deferral
        lastClickUser = user;
        lastClickTime = now;
        if (singleClickTimer){ clearTimeout(singleClickTimer); }
        singleClickTimer = setTimeout(function(){ handleSingleClick(user); lastClickUser = null; lastClickTime = 0; }, DOUBLE_DELAY + 20);
      });

      // Custom double-click detection using click timing on the same user
      // We avoid relying on the native dblclick which can be unreliable in some browsers/contexts
      let lastClickTime = 0;
      let lastClickUser = null;
      const DOUBLE_DELAY = 300;

