    function insertAtCaret(input, text){
      try {
        const start = input.selectionStart || 0;
        const end = input.selectionEnd || 0;
        const v = input.value || '';
        input.value = v.slice(0, start) + text + v.slice(end);
        const pos = start + text.length;
        input.focus();
        input.setSelectionRange && input.setSelectionRange(pos, pos);
      } catch(_){ input.value += text; try{ input.focus(); }catch(_){} }
    }

    function positionPopup(){
      if (!popup || !anchorBtn) return;
      const r = anchorBtn.getBoundingClientRect();
      const left = Math.min(window.innerWidth - popup.offsetWidth - 8, Math.max(8, r.left));
      let top = r.bottom + 6;
      if (top + popup.offsetHeight + 8 > window.innerHeight) {
        top = Math.max(8, r.top - popup.offsetHeight - 6);
      }
      popup.style.left = left + 'px';
      popup.style.top = Math.max(8, top) + 'px';
    }

    function openFor(btn, input){
      anchorBtn = btn; targetInput = input;
      populate();
      popup.classList.add('open');
      positionPopup();
      // Simple focus management: keep focus in input for typing continuity
      try { input && input.focus(); } catch(_){ }
    }
    function close(){
      popup.classList.remove('open');
      anchorBtn = null; targetInput = null;
    }
    function toggleFor(btn, input){
      if (popup.classList.contains('open') && anchorBtn === btn) { close(); }
      else { openFor(btn, input); }
    }

    // Delegated click handler for any emoji button (room or private composers)
    document.addEventListener('click', function(e){
      const btn = e.target && e.target.closest ? e.target.closest('.emoji-btn') : null;
      if (!btn) return;
      const composer = btn.closest('.composer');
      if (!composer) return;
      const input = composer.querySelector('textarea, input[type="text"]');
      if (!input) return;
      e.preventDefault();
      toggleFor(btn, input);
    });

    // Delegate clicks on emojis
    if (grid){
      grid.addEventListener('click', function(e){
        const item = e.target.closest('.item');
        if (!item || !grid.contains(item)) return;
        const emo = item.getAttribute('data-emo');
        if (!emo) return;
        if (targetInput) insertAtCaret(targetInput, emo);
        // Close after selection
        close();
      });
    }

    // Close on outside click
    document.addEventListener('mousedown', function(e){
      if (!popup.classList.contains('open')) return;
      const isBtn = !!(anchorBtn && (e.target === anchorBtn || (anchorBtn.contains && anchorBtn.contains(e.target))));
      const isInside = popup.contains(e.target);
      if (!isBtn && !isInside) close();
    });

    // Close on Escape
    window.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && popup.classList.contains('open')) { close(); }
    });

    // Reposition when viewport changes
    window.addEventListener('resize', function(){ if (popup.classList.contains('open')) positionPopup(); });
    window.addEventListener('scroll', function(){ if (popup.classList.contains('open')) positionPopup(); }, true);
  })();

  // Color picker logic
  (function(){
    const COLORS = ROOM_COLORS.slice();
    const popup = document.getElementById('colorPopup');
    const grid = document.getElementById('colorGrid');
    let anchorBtn = null;

    function swatch(c){
      const title = c;
      const orig = sanitizeRoomColor(c);
      const disp = adjustReceivedColor(orig);
      const bdc = isDarkTheme() ? '#334155' : '#e5e7eb';
      return '<div class="item" data-color="' + orig + '" title="' + title + '" style="gap:6px;"><div class="emo" style="width:24px;height:24px;border-radius:6px;border:1px solid ' + bdc + ';background:' + disp + ';"></div></div>';
    }
    function populate(){
      if (!grid) return;
      grid.innerHTML = COLORS.map(c=>swatch(c)).join('');
    }
    function positionPopup(btn){
      if (!popup || !btn) return;
      const r = btn.getBoundingClientRect();
      const left = Math.min(window.innerWidth - popup.offsetWidth - 8, Math.max(8, r.left));
      let top = r.bottom + 6;
      if (top + popup.offsetHeight + 8 > window.innerHeight) {
        top = Math.max(8, r.top - popup.offsetHeight - 6);
      }
      popup.style.left = left + 'px';
      popup.style.top = Math.max(8, top) + 'px';
    }
    function openFor(btn){
      anchorBtn = btn;
      populate();
      popup.classList.add('open');
      positionPopup(btn);
    }
    function close(){
      popup.classList.remove('open');
      anchorBtn = null;
    }
    function toggle(btn){
      if (popup.classList.contains('open') && anchorBtn === btn) close(); else openFor(btn);
    }
    function setButtonColor(btn, color){
      try {
        const orig = sanitizeRoomColor(color || '#000000');
        const disp = adjustReceivedColor(orig);
        btn.dataset.originalColor = orig;
        btn.style.setProperty('--clr', orig);
        btn.style.background = disp;
        btn.style.borderColor = isDarkTheme() ? '#334155' : '#e5e7eb';
        btn.textContent = '■';
      } catch(_){ }
    }

    // Delegated click for any color button
    document.addEventListener('click', function(e){
      const btn = e.target && e.target.closest ? e.target.closest('.color-btn') : null;
      if (!btn) return;
      e.preventDefault();
      toggle(btn);
    });

    // Handle palette click
    if (grid){
      grid.addEventListener('click', function(e){
        const item = e.target.closest('.item');
        if (!item || !grid.contains(item)) return;
        const col = item.getAttribute('data-color');
        if (!col) return;
        if (anchorBtn){
          setButtonColor(anchorBtn, col);
          // Update room color if this is the room button
          if (anchorBtn.id === 'roomColorBtn'){
            currentRoomColor = sanitizeRoomColor(col);
          } else {
            // If used inside a private panel, store per-user color
            try {
              const panel = anchorBtn.closest('.panel');
              if (panel && typeof panel.id === 'string' && panel.id.indexOf('panel-private-') === 0) {
                const user = panel.id.substring('panel-private-'.length);
                privateColors.set(user, sanitizeRoomColor(col));
              }
            } catch(_){}
          }
        }
        close();
      });
    }

    // Close on outside click
    document.addEventListener('mousedown', function(e){
      if (!popup.classList.contains('open')) return;
      const isBtn = !!(anchorBtn && (e.target === anchorBtn || (anchorBtn.contains && anchorBtn.contains(e.target))));
      const isInside = popup.contains(e.target);
      if (!isBtn && !isInside) close();
    });

    // Close on Escape
    window.addEventListener('keydown', function(e){ if (e.key === 'Escape' && popup.classList.contains('open')) close(); });
    window.addEventListener('resize', function(){ if (popup.classList.contains('open') && anchorBtn) positionPopup(anchorBtn); });
    window.addEventListener('scroll', function(){ if (popup.classList.contains('open') && anchorBtn) positionPopup(anchorBtn); }, true);

    // Expose a refresh helper to rebuild palette on theme change
    window.refreshColorPopupVisuals = function(){
      try {
        if (!popup) return;
        if (popup.classList.contains('open')) {
          populate();
          if (anchorBtn) positionPopup(anchorBtn);
        }
      } catch(_){ }
    };

    // Initialize room button color on load
    try {
      const rb = document.getElementById('roomColorBtn');
      if (rb) setButtonColor(rb, currentRoomColor);
    } catch(_){ }
  })();

  function setUsersTabCount(count){
    const btn = getTabButtonByTarget('panel-users');
    if(!btn) return;
    const base = 'Connectés';
    if(typeof count === 'number' && isFinite(count)){
      btn.textContent = base + ' (' + count + ')';
    } else {
      btn.textContent = base;
    }
  }

  // Mobile users modal logic
  (function(){
    const icon = document.getElementById('mobileUsersIcon');
    const closeBtn = document.getElementById('mobileUsersClose');
    const modal = document.getElementById('mobileUsersModal');
    const container = document.getElementById('mobileUsersContainer');

    function open(){
      try {
        const box = document.getElementById('currentRoomUsers');
        if (container && box && box.parentNode !== container) {
          container.appendChild(box);
        }
        if (modal){ modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); }
        try { document.documentElement.style.overflow = 'hidden'; } catch(_){ }
      } catch(_){ }
    }
    function close(){
      try {
        const right = document.querySelector('#panel-current .right');
        const box = document.getElementById('currentRoomUsers');
        if (right && box && box.parentNode !== right) {
          right.appendChild(box);
        }
        if (modal){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); }
        try { document.documentElement.style.overflow = ''; } catch(_){ }
      } catch(_){ }
    }

    if (icon){ icon.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); open(); }); }
    if (icon){ icon.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } }); }
    if (closeBtn){ closeBtn.addEventListener('click', function(e){ e.preventDefault(); close(); }); }
    if (modal){ modal.addEventListener('click', function(e){ if (e.target === modal) { close(); } }); }

    // Expose for debugging if needed
    window.openMobileUsersModal = open;
    window.closeMobileUsersModal = close;
  })();

</script>
{% endblock %}
