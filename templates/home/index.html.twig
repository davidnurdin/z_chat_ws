  // Long-press utility for touch devices
  function addLongPress(root, selector, handler, duration){
    if(!root) return;
    let timer = null;
    let targetEl = null;
    const threshold = typeof duration === 'number' ? duration : 550;
    function start(e){
      const t = e.target && e.target.closest ? e.target.closest(selector) : null;
      if(!t || !root.contains(t)) return;
      targetEl = t;
      clearTimeout(timer);
      timer = setTimeout(function(){
        try { handler(targetEl, e); } finally { targetEl = null; }
      }, threshold);
    }
    function cancel(){
      clearTimeout(timer);
      timer = null;
      targetEl = null;
    }
    try {
      root.addEventListener('touchstart', start, {passive: true});
      root.addEventListener('touchend', cancel);
      root.addEventListener('touchmove', cancel);
      root.addEventListener('touchcancel', cancel);
    } catch(_) { /* non-touch env */ }
  }

