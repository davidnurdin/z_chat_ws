  function onSocketClose(ev){
    appendMessage('debugMessages', 'Connexion fermée' + (ev && ev.code ? ' (code ' + ev.code + ')' : '') + '.', {system: true});
    appendMessage('debugMessages', 'Veuillez patienter reconnexion en cours ...', {system: true});

    notifyTab('panel-infos');
    try { if (pingWatchTimer) { clearInterval(pingWatchTimer); pingWatchTimer = null; } } catch(_){ }
    setConnectButtonEnabled(false);
    showLoginControls();
    scheduleReconnect();
