  const ROOM_COLORS = ['#000000','#ef4444','#f97316','#f59e0b','#eab308','#84cc16','#22c55e','#10b981','#06b6d4','#0ea5e9','#3b82f6','#6366f1','#8b5cf6','#a855f7','#d946ef','#ec4899','#f43f5e','#7f1d1d','#111827','#6b7280'];
  let currentRoomColor = '#000000';
  const privateColors = new Map(); // user -> color for private messages
  function sanitizeRoomColor(c){
    if (typeof c !== 'string') return '#000000';
    c = c.trim();
    if (ROOM_COLORS.indexOf(c) !== -1) return c;
    // Optionally accept any valid 6-hex color
    if (/^#[0-9a-fA-F]{6}$/.test(c)) return c;
    return '#000000';
  }
  // Determine if the current theme is dark
  function isDarkTheme(){
    try {
      var root = document.documentElement;
      var attr = root.getAttribute('data-theme');
      if (attr === 'dark') return true;
      if (attr === 'light') return false;
      // fallback to system preference
      if (window.matchMedia) { return window.matchMedia('(prefers-color-scheme: dark)').matches; }
    } catch(_){ }
    return false;
  }
  // For received messages, swap pure black/white to keep readability with the current theme
  function adjustReceivedColor(color){
    try {
      var c = (color || '').trim();
      if (!/^#[0-9a-fA-F]{6}$/.test(c)) return color; // keep original if not a 6-hex color
      var up = c.toUpperCase();
      // Keep the simple swap for pure black/white
      if (up === '#000000' && isDarkTheme()) return '#FFFFFF';
      if (up === '#FFFFFF' && !isDarkTheme()) return '#000000';

      // Compute relative luminance (WCAG)
      var r = parseInt(c.substr(1,2),16) / 255;
      var g = parseInt(c.substr(3,2),16) / 255;
      var b = parseInt(c.substr(5,2),16) / 255;
      function lin(v){ return v <= 0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055, 2.4); }
      var L = 0.2126*lin(r) + 0.7152*lin(g) + 0.0722*lin(b);

      // Thresholds chosen for readability without being too aggressive
      if (isDarkTheme()) {
        // On dark background, only flip near-black tones to white (preserve vivid colors like fuchsia)
        if (L < 0.12) return '#FFFFFF';
      } else {
        // On light background, only flip near-white tones to black
        if (L > 0.92) return '#000000';
      }
      return c;
    } catch(_){ return color; }
  }
  // Re-apply adjusted colors to all rendered messages when theme changes
  function reapplyMessageColors(){
    try {
      var spans = document.querySelectorAll('span[data-original-color]');
      spans.forEach(function(s){
        var orig = s.getAttribute('data-original-color') || '#000000';
        var clean = sanitizeRoomColor(orig);
        var adj = adjustReceivedColor(clean);
        s.style.color = adj;
      });
    } catch(_){ }
  }
  function reapplyColorButtons(){
    try {
      var btns = document.querySelectorAll('.color-btn');
      btns.forEach(function(btn){
        var orig = btn.dataset && btn.dataset.originalColor ? btn.dataset.originalColor : (btn.style.getPropertyValue('--clr') || '#000000');
        var clean = sanitizeRoomColor(orig);
        var adj = adjustReceivedColor(clean);
        btn.dataset.originalColor = clean;
        btn.style.setProperty('--clr', clean);
        btn.style.background = adj;
      });
    } catch(_){ }
  }
