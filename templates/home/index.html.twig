            window.closeMobileUsersModal();
          }
        } catch(_){}
      }
      let singleClickTimer = null;
      let suppressClicksUntil = 0;

      function handleSingleClick(user){
        if (!user || isSelf(user)) return;
        // Only prefill if salon panel is active
        const currentPanel = document.getElementById('panel-current');
        if (!currentPanel || !currentPanel.classList.contains('active')) return;
