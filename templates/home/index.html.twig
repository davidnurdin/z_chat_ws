{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
  /* Full-viewport app layout */
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body { font: 16px/1.4 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
  .chat-wrapper {
    margin: 0; max-width: none; width: 100vw; height: calc(100vh - var(--sf-toolbar-height, 0px));
    display: flex; flex-direction: column;
  }
  .controls { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; padding: .5rem; }
  .controls input[type=text] { padding: .4rem .6rem; border: 1px solid #ccc; border-radius: 6px; }
  .controls input[type=button] { padding: .45rem .7rem; border: 1px solid #bbb; background: #f8f8f8; border-radius: 6px; cursor: pointer; }
  .controls input[type=button]:hover { background: #efefef; }

  /* Tabs */
  .tabs { border-bottom: 1px solid #ddd; display: flex; gap: 4px; overflow-x: auto; padding: .25rem .5rem; }
  .tab { appearance: none; background: #f2f2f2; border: 1px solid #ddd; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: .5rem .75rem; cursor: pointer; }
  .tab.active { background: white; border-color: #ccc; font-weight: 600; }
  .tab.closeable { position: relative; padding-right: 2.2rem; }
  .tab .close { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); color: #666; cursor: pointer; font-weight: 700; line-height: 1; width: 1.4rem; height: 1.4rem; display: flex; align-items: center; justify-content: center; border-radius: 999px; }
  .tab .close:hover { background: rgba(0,0,0,0.08); color: #111; }
  /* Flashing attention state for tabs */
  .tab.notify { animation: tab-flash 1.2s ease-in-out infinite; border-color: #eab308; }
  @keyframes tab-flash { 0% { background: #fff59d; } 50% { background: #ffec82; } 100% { background: #fff59d; } }

  /* Panels container fills remaining space */
  .panels { border: 1px solid #ccc; border-radius: 0 8px 8px 8px; background: white; padding: .5rem; flex: 1; min-height: 0; display: flex; }
  .panel { display: none; width: 100%; height: 100%; }
  .panel.active { display: block; }
  .gated { display: none !important; }

  /* Current room layout (fills height) */
  #panel-current.panel.active { display: flex; flex-direction: column; }
  .current-room { display: flex; gap: .75rem; flex: 1; min-height: 0; }
  .current-room .left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .current-room .right { width: 240px; border-left: 1px solid #eee; padding-left: .5rem; display: flex; flex-direction: column; min-height: 0; }
  .current-room .right .users { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }
  .current-room .title { font-weight: 600; margin-bottom: .25rem; }

  /* Rooms layout (fills height) */
  #panel-rooms.panel.active { display: flex; flex-direction: column; }
  .rooms-layout { display: flex; gap: .75rem; flex: 1; min-height: 0; }
  .rooms-layout .left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rooms-layout .right { width: 260px; border-left: 1px solid #eee; padding-left: .5rem; display: flex; flex-direction: column; }
  .rooms-layout .right .box { border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }

  /* Users panel full height */
  #panel-users.panel.active { display: flex; flex-direction: column; }

  /* Private panels full height */
  .panel[id^="panel-private-"].panel.active { display: flex; flex-direction: column; }

  /* Make rooms clickable */
  #roomsListPanel .room-item { cursor: pointer; }

  .messages { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }
  .msg { margin: .25rem 0; padding: .2rem .35rem; border-radius: 4px; transition: background-color .15s ease, color .15s ease; }
  .msg:hover { background: #f0f2f5; }
  /* Contextual hover colors */
  .msg.system:hover { background: #fee2e2; } /* light red for system */
  .msg.g-m:hover { background: #dbeafe; } /* light blue for Homme */
  .msg.g-f:hover { background: #fde2f2; } /* light pink for Femme */
  .msg.g-x:hover { background: #f7f7d1; } /* light yellow/green for Autre */
  .msg.self { font-weight: 700; }
  .msg.system { color: #b91c1c; font-weight: 700; }
  .msg .meta { color: #666; font-size: .85em; }
  #usersListPanel .msg,
  #currentRoomUsers .msg,
  #currentRoomMessages .msg { cursor: pointer; }

  /* Colored username tags */
  .user-tag { font-weight: inherit; }
  .user-tag.m { color: #2563eb; }
  .user-tag.f { color: #ec4899; }
  .user-tag.x { color: #a3a312; }
  /* Rooms count style */
  .room-count { color: #b91c1c; font-weight: 600; }

  .composer { --composer-h: 42px; display: flex; align-items: stretch; gap: .5rem; margin-top: .5rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: .4rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
  .composer textarea, .composer input[type=text] { flex: 1; border: none; outline: none; padding: 0 .65rem; border-radius: 8px; background: #f9fafb; resize: none; max-height: 140px; height: var(--composer-h); min-height: var(--composer-h); line-height: 1.3; }
  .composer textarea:focus, .composer input[type=text]:focus { background: #f3f4f6; }
  .composer .send-btn { appearance: none; border: none; background: #2563eb; color: #fff; padding: 0 .9rem; border-radius: 8px; cursor: pointer; font-weight: 600; min-width: 48px; display: inline-flex; align-items: center; justify-content: center; height: var(--composer-h); min-height: var(--composer-h); }
  .composer .send-btn:hover { background: #1d4ed8; }
  .composer .send-btn:active { transform: translateY(1px); }
  .composer .emoji-btn { appearance: none; border: 1px solid #e5e7eb; background: #f3f4f6; color: #111; padding: 0 .7rem; border-radius: 8px; cursor: pointer; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; height: var(--composer-h); min-height: var(--composer-h); }
  .composer .emoji-btn:hover { background: #e5e7eb; }
  .emoji-popup { position: fixed; z-index: 9999; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; box-shadow: 0 10px 24px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.08); padding: .5rem; width: 260px; display: none; }
  .emoji-popup.open { display: block; }
  .emoji-popup .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; }
  .emoji-popup .item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem; padding: .35rem; border-radius: 8px; cursor: pointer; user-select: none; border: 1px solid transparent; }
  .emoji-popup .item:hover { background: #f3f4f6; border-color: #e5e7eb; }
  .emoji-popup .emo { font-size: 20px; line-height: 1; }
  .emoji-popup .sc { font-size: 11px; color: #6b7280; }

  .muted { color: #6b7280; }
  .small { font-size: .85em; }

  /* Debug panel full height */
  #panel-infos.panel.active { display: flex; flex-direction: column; }
  .debug { width: 100%; flex: 1; min-height: 0; }
  /* Mobile responsiveness */
  @media (max-width: 900px) {
    body { font-size: 15px; }
    .controls { padding: .5rem; gap: .4rem; }
    .tab { padding: .5rem .6rem; }
    .current-room { flex-direction: column; }
    .current-room .right { width: auto; border-left: none; border-top: 1px solid #eee; padding-left: 0; padding-top: .5rem; }
    .rooms-layout { flex-direction: column; }
    .rooms-layout .right { width: auto; border-left: none; border-top: 1px solid #eee; padding-left: 0; padding-top: .5rem; }
    .composer { gap: .4rem; }
    .messages { padding: .4rem; }
  }
  /* Prefer dynamic viewport on mobile UAs that support it */
  @supports (height: 100dvh) {
    .chat-wrapper { height: calc(100dvh - var(--sf-toolbar-height, 0px)); }
  }
</style>

<div class="chat-wrapper">
  <div class="controls">
    <input type="text" id="login" value="" placeholder="login" />
    <label><input type="radio" name="gender" value="H"> H</label>
    <label><input type="radio" name="gender" value="F"> F</label>
    <label><input type="radio" name="gender" value="X" checked> X</label>
    <input type="button" id="btn1" value="Se connecter" onclick="authenticate()">
  </div>

  <div class="tabs" id="tabs">
    <button class="tab active" data-target="panel-infos">Infos</button>
    <button class="tab gated" data-target="panel-users">Connectés</button>
    <button class="tab gated" data-target="panel-rooms">Salons</button>
    <button class="tab gated" data-target="panel-current" id="tab-current-room">Salon : -</button>
    <!-- Private tabs will be appended here -->
  </div>
  <div class="panels">
    <div class="panel gated" id="panel-users">
      <div id="usersListPanel" class="messages"></div>
    </div>

    <div class="panel gated" id="panel-rooms">
      <div class="rooms-layout">
        <div class="left">
          <div class="small muted">Liste des salons</div>
          <div id="roomsListPanel" class="messages"></div>
        </div>
        <div class="right">
          <div class="small muted">Créer un salon</div>
          <div class="box">
            <input type="text" id="createRoomName" placeholder="Nom du salon" onkeypress="if(event.key==='Enter'){ const v=this.value.trim(); if(v){ enterRoom(v); this.value=''; }}" />
            <input type="button" value="Créer" onclick="(function(){ const el=document.getElementById('createRoomName'); const v=(el.value||'').trim(); if(v){ enterRoom(v); el.value=''; } })()">
            <div class="small muted" style="margin-top:.5rem;">Astuce: créer = entrer dans un salon nouveau.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel gated" id="panel-current">
      <div class="current-room">
        <div class="left">
          <div class="title small muted">Messages du salon</div>
          <div class="messages" id="currentRoomMessages"></div>
          <div class="composer" id="roomComposer">
            <input type="text" id="roomInput" placeholder="Votre message au salon en cours..." onkeydown="if(event.key==='Enter'){ event.preventDefault(); sendFromComposer(this,'room'); }" />
            <button type="button" class="emoji-btn" id="roomEmojiBtn" title="Insérer un emoji">:-)</button>
            <button class="send-btn" title="Envoyer" onclick="sendFromComposer(document.getElementById('roomInput'),'room')">-&gt;</button>
          </div>
        </div>
        <div class="right">
          <div class="title small muted">Connectés au salon</div>
          <div id="currentRoomUsers" class="users"></div>
        </div>
      </div>
    </div>

    <div class="panel active" id="panel-infos">
      <div class="small muted">Informations / Debug</div>
      <div id="debugMessages" class="messages"></div>
    </div>

    <!-- Private panels will be appended here -->
  </div>
</div>

<!-- Emoji picker popup -->
<div id="emojiPopup" class="emoji-popup" role="dialog" aria-label="Sélecteur d'emoji" aria-modal="false">
  <div class="grid" id="emojiGrid"></div>
</div>

<script>
  // Account for Symfony debug toolbar height and prevent page scroll
  (function initToolbarSizing(){
    function recalcToolbarInset(){
      try {
        var h = 0;
        var bs = getComputedStyle(document.body);
        var pad = parseInt(bs.paddingBottom, 10) || 0;
        var mar = parseInt(bs.marginBottom, 10) || 0;
        h = Math.max(h, pad, mar);
        var sf = document.querySelector('div[id^="sfwdt"]');
        if (sf && sf.offsetHeight) h = Math.max(h, sf.offsetHeight);
        document.documentElement.style.setProperty('--sf-toolbar-height', (h|0) + 'px');
      } catch(_) { /* noop */ }
    }
    window.addEventListener('load', recalcToolbarInset);
    window.addEventListener('resize', recalcToolbarInset);
    // Observe DOM changes that might affect toolbar size/visibility
    try {
      var mo = new MutationObserver(recalcToolbarInset);
      mo.observe(document.body, {attributes: true, childList: true, subtree: true});
    } catch(_) { /* older browsers */ }
    // Initial and short polling to catch first paint updates
    recalcToolbarInset();
    var ticks = 0; var iv = setInterval(function(){ recalcToolbarInset(); if(++ticks > 10) clearInterval(iv); }, 300);
  })();

  // Random pseudo generation for default login
  (function initRandomLogin(){
    function generateRandomPseudo(){
      var adjectives = [
        'Agile','Brave','Calm','Daring','Eager','Fierce','Gentle','Happy','Icy','Jolly',
        'Kind','Lively','Mighty','Nimble','Odd','Proud','Quick','Royal','Sunny','Tricky',
        'Ultra','Vivid','Witty','Xtra','Young','Zesty','Amber','Bold','Crimson','Dusty',
        'Emerald','Fluffy','Golden','Hazel','Indigo','Jade','Khaki','Lunar','Mango','Nova',
        'Ocean','Plum','Quartz','Ruby','Silver','Teal','Umber','Velvet','Walnut','Xenon',
        'Yellow','Zen','Arctic','Blazing','Crystal','Deep','Electric','Frosty','Glowing','Honey',
        'Iron','Jazzy','Keen','Lucky','Magic','Neon','Obsidian','Polar','Quiet','Rapid',
        'Silent','Turbo','Urban','Vast','Wild','Xtreme','Youngster','Zephyr','Atomic','Binary',
        'Cosmic','Digital','Epic','Fusion','Galactic','Hyper','Ion','Jet','Kinetic','Logic'
      ];
      var animals = [
        'Falcon','Tiger','Panther','Wolf','Eagle','Lion','Leopard','Cobra','Viper','Shark',
        'Puma','Lynx','Fox','Bear','Bison','Hawk','Raven','Otter','Seal','Whale',
        'Dolphin','Orca','Moose','Deer','Horse','Badger','Beaver','Marten','Sable','Boar',
        'Panda','Gorilla','Koala','Kangaroo','Gazelle','Antelope','Rhino','Hippo','Giraffe','Zebra',
        'Penguin','Albatross','Pelican','Heron','Crane','Swan','Duck','Goose','Owl','Condor',
        'Python','Anaconda','Iguana','Gecko','Chameleon','Dragon','Phoenix','Griffin','Hydra','Minotaur',
        'Mustang','Stallion','Buffalo','Cheetah','Jaguar','Mongoose','Raccoon','Skunk','Squirrel','Weasel',
        'Stingray','Manta','Barracuda','Marlin','Swordfish','Tuna','Salmon','Trout','Carp','Catfish'
      ];
      function pick(arr){ return arr[(Math.random()*arr.length)|0]; }
      var name = pick(adjectives) + pick(animals) + (100 + ((Math.random()*9900)|0));
      return name;
    }
    function assign(){
      try {
        var el = document.getElementById('login');
        if(!el) return;
        if(!el.value || el.value === 'user1'){
          el.value = generateRandomPseudo();
        }
      } catch(_){}
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', assign);
    } else {
      assign();
    }
  })();

  // Tab logic
  function getTabButtonByTarget(targetId){
    return Array.from(document.querySelectorAll('.tab')).find(t => t.dataset.target === targetId) || null;
  }
  function activateTabByTarget(targetId){
    document.querySelectorAll('.tab').forEach(t=>{
      const isActive = t.dataset.target===targetId;
      t.classList.toggle('active', isActive);
      if(isActive) t.classList.remove('notify');
    });
    document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active', p.id===targetId));
    // Focus appropriate composer when a tab becomes active
    try {
      if (targetId === 'panel-current') {
        const roomInput = document.getElementById('roomInput');
        if (roomInput) { roomInput.focus(); roomInput.select && roomInput.select(); }
      } else if (typeof targetId === 'string' && targetId.indexOf('panel-private-') === 0) {
        const p = document.getElementById(targetId);
        if (p) {
          const input = p.querySelector('textarea, input[type="text"]');
          if (input) { input.focus(); input.select && input.select(); }
        }
      }
    } catch (_) { /* noop */ }
  }
  function notifyTab(targetId){
    const btn = getTabButtonByTarget(targetId);
    if(!btn) return;
    const isActive = btn.classList.contains('active');
    if(!isActive) btn.classList.add('notify');
  }
  // Autosize helper for nicer multi-line composers
  function autosizeTextarea(el){
    if(!el) return;
    if (el.tagName !== 'TEXTAREA') return;
    try {
      el.style.height = 'auto';
      const max = 140; // px
      el.style.height = Math.min(max, el.scrollHeight) + 'px';
    } catch(_){}
  }
  // Generic send helper for composers (room/private)
  function sendFromComposer(el, type, toUser){
    if(!el) return;
    const value = (el.value || '').trim();
    if(!value) return;
    if(type === 'room'){
      writeRoom(value);
    } else if (type === 'private'){
      writePrivate(value, toUser);
    }
    el.value = '';
    autosizeTextarea(el);
  }
  function handleTabSelectionFromEvent(e){
    const btn = e.target.closest('.tab');
    if(!btn) return;
    const target = btn.dataset.target;
    if(target) {
      activateTabByTarget(target);
      // Auto-refresh when selecting certain tabs (click or hover)
      if (target === 'panel-rooms'){
        const panel = document.getElementById('roomsListPanel');
        if(panel) panel.innerHTML = '';
        getRoomsList();
      } else if (target === 'panel-users'){
        const panel = document.getElementById('usersListPanel');
        if(panel) panel.innerHTML = '';
        listAllUsersByType('standardUser');
      }
      // Focus the composer input when selecting a private tab
      if (typeof target === 'string' && target.indexOf('panel-private-') === 0) {
        const p = document.getElementById(target);
        if (p) {
          const input = p.querySelector('textarea, input[type="text"]');
          if (input) { try { input.focus(); input.select && input.select(); } catch(_){} }
        }
      }
    }
  }
  document.getElementById('tabs').addEventListener('click', function(e){
    handleTabSelectionFromEvent(e);
  });

  // Keyboard navigation across tabs with Ctrl+ArrowLeft/Right
  (function(){
    function isEditableTarget(el){
      if(!el) return false;
      const tn = el.tagName;
      if (tn === 'INPUT' || tn === 'TEXTAREA') return true;
      if (el.isContentEditable) return true;
      return false;
    }
    function getVisibleTabs(){
      return Array.from(document.querySelectorAll('.tab')).filter(btn => btn.offsetParent !== null);
    }
    window.addEventListener('keydown', function(e){
      if (!e.ctrlKey || e.altKey || e.metaKey) return;
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const tgt = e.target;
      // Previously ignored editable targets (inputs/textarea). Now allow Ctrl+Arrow to work everywhere, including inside editors.
      const tabs = getVisibleTabs();
      if (tabs.length === 0) return;
      const activeIdx = tabs.findIndex(t => t.classList.contains('active'));
      if (activeIdx === -1) return;
      let nextIdx = activeIdx;
      if (e.key === 'ArrowRight') {
        nextIdx = (activeIdx + 1) % tabs.length;
      } else if (e.key === 'ArrowLeft') {
        nextIdx = (activeIdx - 1 + tabs.length) % tabs.length;
      }
      const next = tabs[nextIdx];
      if (next && next.dataset && next.dataset.target){
        e.preventDefault();
        const target = next.dataset.target;
        activateTabByTarget(target);
        // Trigger the same auto-refresh behavior when navigating with keyboard
        if (target === 'panel-rooms'){
          const panel = document.getElementById('roomsListPanel');
          if(panel) panel.innerHTML = '';
          getRoomsList();
        } else if (target === 'panel-users'){
          const panel = document.getElementById('usersListPanel');
          if(panel) panel.innerHTML = '';
          listAllUsersByType('standardUser');
        }
      }
    });
  })();

  // Close active private tab on Escape key: go to next private if any, else go to Salon
  (function(){
    window.addEventListener('keydown', function(e){
      if (e.key !== 'Escape') return;
      try {
        const activeTabBtn = Array.from(document.querySelectorAll('.tab')).find(t => t.classList.contains('active'));
        if (!activeTabBtn) return;
        const target = activeTabBtn.dataset && activeTabBtn.dataset.target;
        if (!target || target.indexOf('panel-private-') !== 0) return;
        e.preventDefault();
        const user = target.substring('panel-private-'.length);
        // Find the next private tab to the right
        const privateBtns = Array.from(document.querySelectorAll('.tab')).filter(b => b.dataset && typeof b.dataset.target === 'string' && b.dataset.target.indexOf('panel-private-') === 0);
        const idx = privateBtns.findIndex(b => b.dataset.target === target);
        let nextTargetId = null;
        if (idx >= 0 && idx + 1 < privateBtns.length) {
          nextTargetId = privateBtns[idx + 1].dataset.target;
        }
        // Close without auto-activating, then activate next or Salon
        if (user) closePrivateUI(user, {after:'none'});
        if (nextTargetId) {
          activateTabByTarget(nextTargetId);
        } else {
          activateTabByTarget('panel-current');
        }
      } catch(_){}
    });
  })();

  // Long-press utility for touch devices
  function addLongPress(root, selector, handler, duration){
    if(!root) return;
    let timer = null;
    let targetEl = null;
    const threshold = typeof duration === 'number' ? duration : 550;
    function start(e){
      const t = e.target && e.target.closest ? e.target.closest(selector) : null;
      if(!t || !root.contains(t)) return;
      targetEl = t;
      clearTimeout(timer);
      timer = setTimeout(function(){
        try { handler(targetEl, e); } finally { targetEl = null; }
      }, threshold);
    }
    function cancel(){
      clearTimeout(timer);
      timer = null;
      targetEl = null;
    }
    try {
      root.addEventListener('touchstart', start, {passive: true});
      root.addEventListener('touchend', cancel);
      root.addEventListener('touchmove', cancel);
      root.addEventListener('touchcancel', cancel);
    } catch(_) { /* non-touch env */ }
  }

  // Join room on double-click in rooms list; long-press on mobile
  (function(){
    const panel = document.getElementById('roomsListPanel');
    if(panel){
      panel.addEventListener('dblclick', function(e){
        const item = e.target.closest('.room-item');
        if(!item) return;
        const room = item.dataset.room || (item.querySelector('.meta') ? item.querySelector('.meta').textContent.trim() : '');
        if(room){ enterRoom(room); }
      });
      // Long-press to enter room on touch devices
      addLongPress(panel, '.room-item', function(item){
        const room = item.dataset.room || (item.querySelector('.meta') ? item.querySelector('.meta').textContent.trim() : '');
        if(room){ enterRoom(room); }
      });
    }
  })();

  // Open private on double-click in users list (Connectés); long-press on mobile
  (function(){
    const panel = document.getElementById('usersListPanel');
    if(panel){
      panel.addEventListener('dblclick', function(e){
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        const user = (item.textContent || '').trim();
        if(user && !isSelf(user)){
          const {panel: privPanel} = ensurePrivateTab(user);
          activateTabByTarget(privPanel.id);
        } else if (user && isSelf(user)) {
          debugLog('Conversation privée avec vous‑même non autorisée.\n');
        }
      });
      // Long-press to open private on touch devices
      addLongPress(panel, '.msg', function(item){
        const user = (item.textContent || '').trim();
        if(user && !isSelf(user)){
          const {panel: privPanel} = ensurePrivateTab(user);
          activateTabByTarget(privPanel.id);
        } else if (user && isSelf(user)) {
          debugLog('Conversation privée avec vous‑même non autorisée.\n');
        }
      });
    }
  })();

  // Open private on double-click in current room sidebar users list
  // Single-click to prefill room composer with "pseudo >"; long-press to open private on touch
  (function(){
    const panel = document.getElementById('currentRoomUsers');
    if(panel){
      panel.addEventListener('click', function(e){
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        const user = (item.textContent || '').trim();
        if(!user) return;
        if (isSelf(user)) return; // prevent selecting own pseudo
        const input = document.getElementById('roomInput');
        if(input){
          input.value = user + ' > ';
          try { input.focus(); input.selectionStart = input.selectionEnd = input.value.length; } catch(_){}
        }
      });
      panel.addEventListener('dblclick', function(e){
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        const user = (item.textContent || '').trim();
        if(user && !isSelf(user)){
          const {panel: privPanel} = ensurePrivateTab(user);
          activateTabByTarget(privPanel.id);
        } else if (user && isSelf(user)) {
          debugLog('Conversation privée avec vous‑même non autorisée.\n');
        }
      });
      // Long-press to open private on touch devices
      addLongPress(panel, '.msg', function(item){
        const user = (item.textContent || '').trim();
        if(user && !isSelf(user)){
          const {panel: privPanel} = ensurePrivateTab(user);
          activateTabByTarget(privPanel.id);
        } else if (user && isSelf(user)) {
          debugLog('Conversation privée avec vous‑même non autorisée.\n');
        }
      });
    }
  })();

  // Click on a message in current room to prefill composer with "pseudo >"
  // Double-click a message to open a private chat with that user; also supports [JOIN] lines; long-press on touch devices does the same
  (function(){
    const panel = document.getElementById('currentRoomMessages');
    if(panel){
      function parseAuthorFromMsgEl(el){
        const text = (el && el.textContent || '').trim();
        if(!text) return null;
        if(text[0] === '[') return null; // skip system/join/quit lines for single-click prefill
        const idx = text.indexOf(' > ');
        if(idx <= 0) return null;
        return text.substring(0, idx).trim();
      }
      function parseJoinUserFromMsgEl(el){
        const text = (el && el.textContent || '').trim();
        if(!text || text.indexOf('[JOIN] ') !== 0) return null; // expected: [JOIN] USER a rejoint ROOM
        const rest = text.substring(7);
        const idx = rest.indexOf(' a rejoint');
        if(idx <= 0) return null;
        return rest.substring(0, idx).trim();
      }
      panel.addEventListener('click', function(e){
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        const user = parseAuthorFromMsgEl(item);
        if(!user) return; // do not prefill on system lines like [JOIN]/[QUIT]
        if (isSelf(user)) return; // prevent selecting own pseudo
        const input = document.getElementById('roomInput');
        if(input){
          input.value = user + ' > ';
          try { input.focus(); input.selectionStart = input.selectionEnd = input.value.length; } catch(_){}
        }
      });
      panel.addEventListener('dblclick', function(e){
        const item = e.target.closest('.msg');
        if(!item || !panel.contains(item)) return;
        let user = parseAuthorFromMsgEl(item);
        if(!user){ user = parseJoinUserFromMsgEl(item); }
        if(!user) return;
        if (isSelf(user)) { debugLog('Conversation privée avec vous‑même non autorisée.\n'); return; }
        const {panel: privPanel} = ensurePrivateTab(user);
        activateTabByTarget(privPanel.id);
      });
      // Touch long-press to open private as a mobile alternative to double-click
      addLongPress(panel, '.msg', function(item){
        let user = parseAuthorFromMsgEl(item);
        if(!user){ user = parseJoinUserFromMsgEl(item); }
        if(!user) return;
        if (isSelf(user)) { debugLog('Conversation privée avec vous‑même non autorisée.\n'); return; }
        const {panel: privPanel} = ensurePrivateTab(user);
        activateTabByTarget(privPanel.id);
      });
    }
  })();

  // Current room state and helpers
  let currentRoomName = null;
  let currentRoomUsers = new Set();
  let currentLogin = null;
  let currentGender = 'X';
  const userGenders = new Map(); // user -> 'H' | 'F' | 'X'
  function isSelf(user){ return !!currentLogin && user === currentLogin; }
  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]); }); }
  function genderCodeToClass(g){ return g === 'H' ? 'm' : (g === 'F' ? 'f' : 'x'); }
  function renderUserHTML(user){
    const g = userGenders.get(user) || (isSelf(user) ? currentGender : 'X');
    const cls = 'user-tag ' + genderCodeToClass(g);
    return '<span class="' + cls + '\">' + escapeHtml(user) + '</span>';
  }
  // Sorting helpers: F first, then H, then X; alphabetical within each
  function genderPriority(g){ return g === 'F' ? 0 : (g === 'H' ? 1 : 2); }
  function getUserGender(user){ return userGenders.get(user) || (isSelf(user) ? currentGender : 'X'); }
  function sortUsersByGenderThenName(a, b){
    const ga = getUserGender(a); const gb = getUserGender(b);
    const pa = genderPriority(ga); const pb = genderPriority(gb);
    if (pa !== pb) return pa - pb;
    return String(a).localeCompare(String(b), undefined, {sensitivity: 'base'});
  }
  function sortEntriesByGenderThenName(entries){
    return entries.sort(function(e1, e2){
      const p1 = genderPriority(e1 && e1.gender ? e1.gender : 'X');
      const p2 = genderPriority(e2 && e2.gender ? e2.gender : 'X');
      if (p1 !== p2) return p1 - p2;
      return String(e1 && e1.login ? e1.login : '').localeCompare(String(e2 && e2.login ? e2.login : ''), undefined, {sensitivity:'base'});
    });
  }
  function setCurrentRoomName(name){
    currentRoomName = name || '-';
    updateCurrentRoomTabTitle();
  }
  function updateCurrentRoomTabTitle(){
    const tab = document.getElementById('tab-current-room');
    if(!tab) return;
    if (!currentRoomName || currentRoomName === '-') {
      tab.textContent = 'Salon : -';
      return;
    }
    const count = (currentRoomUsers && typeof currentRoomUsers.size === 'number') ? currentRoomUsers.size : 0;
    tab.textContent = 'Salon : ' + currentRoomName + ' (' + count + ')';
  }
  function renderCurrentRoomUsers(){
    const box = document.getElementById('currentRoomUsers');
    if(!box) return;
    if(!currentRoomUsers || currentRoomUsers.size===0){
      box.innerHTML = '<div class="muted small">Personne</div>';
      updateCurrentRoomTabTitle();
      return;
    }
    const list = Array.from(currentRoomUsers).sort(sortUsersByGenderThenName);
    box.innerHTML = list.map(function(u){ var g = getUserGender(u) || 'X'; var gcls = ' g-' + genderCodeToClass(g); return '<div class="msg' + (isSelf(u) ? ' self' : '') + gcls + '\">' + renderUserHTML(u) + '</div>'; }).join('');
    updateCurrentRoomTabTitle();
  }

  const privateTabs = new Map(); // user -> {tab, panel}
  const privateHistory = new Map(); // user -> [{text, bold}]
  function closePrivateUI(user, opts){
    try {
      const entry = privateTabs.get(user);
      if(!entry) return;
      if (entry.tab && entry.tab.parentNode) entry.tab.parentNode.removeChild(entry.tab);
      if (entry.panel && entry.panel.parentNode) entry.panel.parentNode.removeChild(entry.panel);
      privateTabs.delete(user);
      // Default behavior: go back to current room unless caller overrides
      const after = opts && opts.after ? opts.after : 'current';
      if (after === 'current') {
        activateTabByTarget('panel-current');
      } // when after === 'none', do nothing here; caller will decide
    } catch(_){}
  }
  function ensurePrivateTab(user){
    if(privateTabs.has(user)) return privateTabs.get(user);
    const tabs = document.getElementById('tabs');
    const tab = document.createElement('button');
    tab.className = 'tab closeable';
    const panelId = 'panel-private-' + user;
    tab.dataset.target = panelId;
    tab.innerHTML = 'Privé: ' + renderUserHTML(user) + ' <span class="close" title="Fermer">×</span>';

    // Insert after existing tabs
    tabs.appendChild(tab);

    const panel = document.createElement('div');
    panel.className = 'panel';
    panel.id = panelId;
    panel.innerHTML = '<div class="messages" id="messages-private-' + user + '"></div>'+
      '<div class="composer">\n' +
      '  <textarea rows="2" placeholder="Message privé à ' + user + '..." oninput="autosizeTextarea(this)" onkeydown="if(event.key===\'Enter\' && !event.shiftKey){ event.preventDefault(); sendFromComposer(this,\'private\', \'' + user + '\'); }"></textarea>\n' +
      '  <button class="send-btn" title="Envoyer" onclick="sendFromComposer(this.previousElementSibling,\'private\', \'' + user + '\')">-&gt;</button>\n' +
      '</div>';
    document.querySelector('.panels').appendChild(panel);

    // Transform private composer to single-line input
    try {
      const ta = panel.querySelector('textarea');
      if (ta) {
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.placeholder = ta.getAttribute('placeholder') || '';
        inp.addEventListener('keydown', function(event){ if(event.key==='Enter'){ event.preventDefault(); sendFromComposer(inp,'private', user); } });
        ta.parentNode.replaceChild(inp, ta);
      }
    } catch(_){}

    // Restore history if any
    try {
      const hist = privateHistory.get(user);
      if (Array.isArray(hist) && hist.length) {
        const box = document.getElementById('messages-private-' + user);
        if (box) {
          hist.forEach(m => {
            const d = document.createElement('div');
            d.className = 'msg' + (m && m.system ? ' system' : '');
            if (m && typeof m.text !== 'undefined') d.textContent = m.text;
            if (m && m.bold) d.style.fontWeight = '700';
            box.appendChild(d);
          });
          // Scroll to bottom after restoration
          box.scrollTop = box.scrollHeight;
        }
      }
    } catch(_){ }

    // Insert one-time system safety warning
    try {
      const boxId = 'messages-private-' + user;
      const hist0 = privateHistory.get(user);
      const alreadyWarned = Array.isArray(hist0) && hist0.some(function(m){ return m && m.system === true; });
      if (!alreadyWarned) {
        appendMessage(boxId, 'Vous ne devez jamais communiquer des informations personnelles à votre interlocuteur', {system: true});
      }
    } catch(_){}

    // Close handling
    tab.querySelector('.close').addEventListener('click', function(ev){
      ev.stopPropagation();
      closePrivateUI(user);
    });

    const entry = {tab, panel};
    privateTabs.set(user, entry);
    return entry;
  }

  function appendMessage(containerId, text, opts){
    const box = document.getElementById(containerId);
    if(!box) return;
    // Determine if user is near the bottom before appending (except Debug which always autoscrolls)
    const threshold = 8; // px
    const forceAuto = (containerId === 'debugMessages');
    const isNearBottom = forceAuto || ((box.scrollTop + box.clientHeight) >= (box.scrollHeight - threshold));
    const div = document.createElement('div');
    let cls = 'msg';
    if (opts && opts.system) { cls += ' system'; }
    if (opts && opts.extraClass) { cls += ' ' + opts.extraClass; }
    div.className = cls;
    if (opts && opts.html) {
      div.innerHTML = opts.html;
    } else {
      div.textContent = text;
    }
    if (opts && opts.bold) {
      div.style.fontWeight = '700';
    }
    box.appendChild(div);

    // Record history for private conversations
    try {
      if (typeof containerId === 'string' && containerId.indexOf('messages-private-') === 0){
        const user = containerId.substring('messages-private-'.length);
        const arr = privateHistory.get(user) || [];
        arr.push({text: text, bold: !!(opts && opts.bold), system: !!(opts && opts.system)});
        privateHistory.set(user, arr);
      }
    } catch(_){ }

    // Auto-scroll: always for Infos/Debug; else only if user wasn't reading older messages
    if (forceAuto || isNearBottom) {
      box.scrollTop = box.scrollHeight;
    }
  }

  // Existing controls
  setInterval(function(){
    let trame = {'type': 'getTimePing'};
    socket.send(JSON.stringify(trame));
    debugLog('get Time Ping sent...\n');
  },30000);

  function debugLog(text){
    try {
      const lines = String(text).split('\n');
      lines.forEach(function(line){
        const t = (line || '').replace(/\r/g,'').trimEnd();
        if (t) appendMessage('debugMessages', t);
      });
    } catch(_) { /* noop */ }
    notifyTab('panel-infos');
  }

  function revealGatedUI(){
    document.querySelectorAll('.gated').forEach(el => el.classList.remove('gated'));
  }

  function listAllUsersByType(type){
    let trame = {'type': 'listAllUsers', 'userType': type};
    socket.send(JSON.stringify(trame));
    debugLog('List all users sent...\n');
    // Show users tab when requesting list
    const panel = document.getElementById('usersListPanel');
    if(panel) panel.innerHTML = '';
    activateTabByTarget('panel-users');
  }

  function getRoomsList(){
    let trame = {'type': 'listRoom'};
    socket.send(JSON.stringify(trame));
    debugLog('Get rooms list sent...\n');
  }

  function writePrivate(message,to){
    if(!message) return;
    if(isSelf(to)){
      debugLog('Impossible d\'envoyer un message privé à vous‑même.\n');
      return;
    }
    let trame = {'type': 'writePrivate', 'message': message, 'to': to};
    socket.send(JSON.stringify(trame));
    debugLog('PM -> ' + to + ': ' + message + '\n');
    const {panel} = ensurePrivateTab(to);
    appendMessage('messages-private-' + to, currentLogin + ' > ' + message, {bold: true, html: renderUserHTML(currentLogin) + ' &gt; ' + escapeHtml(message), extraClass: ('g-' + genderCodeToClass(currentGender || 'X'))});
    activateTabByTarget(panel.id);
  }

  function writeRoom(message){
    if(!message) return;
    let trame = {'type': 'writeRoom', 'message': message};
    socket.send(JSON.stringify(trame));
    debugLog('Room -> ' + message + '\n');
  }

  function enterRoom(room){
    let trame = {'type': 'enterRoom', 'name': room};
    socket.send(JSON.stringify(trame));
    debugLog('Enter room ' + room + ' sent...\n');
  }

  function authenticate(){
    const genderEl = document.querySelector('input[name="gender"]:checked');
    const gender = genderEl ? genderEl.value : 'X';
    let trame = { 'type' : 'auth' , 'login' : document.getElementById('login').value , 'password' : 'pass', 'gender': gender };
    socket.send(JSON.stringify(trame));
    debugLog('Authentication sent...\n');
  }

  // WebSocket connection
  const socket = new WebSocket('wss://localhost/ws/chat');
  socket.addEventListener('open', function(){
    debugLog('WebSocket is connected...\n');
    socket.addEventListener('close', function(){ console.log('WebSocket is closed...'); });
  });

  socket.addEventListener('message', function (event) {
    let data = event.data;
    if (data instanceof Blob) {
      let reader = new FileReader();
      reader.onload = function() {
        let text = reader.result;
        const json = JSON.parse(text);
        console.log(json);

        if (json.type === 'message'){
          debugLog(json.payload + '\n');
        }

        if (json.type === 'auth'){
          if (json.status === 'ok'){
            debugLog('Authentication successful\n');
            currentLogin = json.login;
            currentGender = json.gender || (function(){
              var ge = document.querySelector('input[name="gender"]:checked');
              return ge ? ge.value : 'X';
            })();
            try { userGenders.set(currentLogin, currentGender); } catch(_){ }
            document.title = json.login;
            revealGatedUI();
            try { var c = document.querySelector('.controls'); if (c) c.style.display = 'none'; } catch(_){}
            enterRoom('general');
          } else {
            debugLog('Authentication failed : ' + json.reason + '\n');
          }
        }

        if (json.type === 'countAll'){
          debugLog('Count all users : ' + json.count + '\n');
          try { setUsersTabCount(json.count); } catch(_) {}
        }

        if (json.type === 'enterRoom'){
          debugLog((json.status==='ok' ? 'Entered room successfully' : 'Failed to enter room') + '\n');
          if(json.status==='ok' && json.name){
            setCurrentRoomName(json.name);
            // Clear previous room messages when entering a new room
            try { const box = document.getElementById('currentRoomMessages'); if (box) box.innerHTML = ''; } catch(_) {}
            // Clear the room composer input when entering a room
            try { const ri = document.getElementById('roomInput'); if (ri) ri.value = ''; } catch(_) {}
            currentRoomUsers = new Set();
            renderCurrentRoomUsers();
            appendMessage('currentRoomMessages', 'Entrée dans le salon: ' + json.name, {system: true});
            activateTabByTarget('panel-current');
          }
        }

        if (json.type === 'writeRoom'){
          debugLog((json.status==='ok' ? 'Message sent to room successfully' : 'Failed to send message to room') + '\n');
        }

        if (json.type === 'messageRoom'){
          const from = json.from || '?';
          const payload = json.payload || '';
          const highlight = (from === currentLogin) || (typeof currentLogin === 'string' && payload.indexOf(currentLogin + ' >') === 0);
          const html = renderUserHTML(from) + ' &gt; ' + escapeHtml(payload);
          const g = getUserGender(from) || 'X';
          const extraClass = 'g-' + genderCodeToClass(g);
          appendMessage('currentRoomMessages', from + ' > ' + payload, {bold: !!highlight, html, extraClass});
          // If someone addresses us in the room, notify the Current Room tab (no auto-switch)
          if (typeof currentLogin === 'string' && payload.indexOf(currentLogin + ' >') === 0) {
            notifyTab('panel-current');
          }
        }

        if (json.type === 'messagePrivate'){
          const from = json.from || 'inconnu';
          const {panel} = ensurePrivateTab(from);
          const html = renderUserHTML(from) + ' &gt; ' + escapeHtml(json.payload || '');
          const g = getUserGender(from) || 'X';
          const extraClass = 'g-' + genderCodeToClass(g);
          appendMessage('messages-private-' + from, (json.from||'?') + ' > ' + (json.payload||''), {html, extraClass});
          // Do not auto-switch on incoming private messages; just notify the tab
          notifyTab(panel.id);
        }

        if (json.type === 'listUserInRoom'){
          try {
            const list = json.list;
            // Normalize to array of {login, gender}
            let entries = [];
            if (Array.isArray(list)) {
              if (list.length && typeof list[0] === 'object') {
                entries = list.map(function(o){ return {login: o.login, gender: o.gender || 'X'}; });
              } else {
                entries = list.map(function(u){ return {login: u, gender: userGenders.get(u) || 'X'}; });
              }
            } else if (typeof list === 'string') {
              const arr = list.split(',').map(s=>s.trim()).filter(Boolean);
              entries = arr.map(function(u){ return {login: u, gender: userGenders.get(u) || 'X'}; });
            }

            // Update gender map
            entries.forEach(function(e){ if (e && e.login) userGenders.set(e.login, e.gender || 'X'); });

            // Apply sorting by gender then name
            const sortedEntries = sortEntriesByGenderThenName(entries.slice());

            // Update current room sidebar if the payload matches current room
            if (json.room && json.room === currentRoomName) {
              currentRoomUsers = new Set(sortedEntries.map(e=>e.login));
              renderCurrentRoomUsers();
            }

            // Also show in the Users tab as before
            const panel = document.getElementById('usersListPanel');
            const title = 'Utilisateurs dans le salon (' + (json.room||'?') + ')';
            let html = '<div class="small muted">' + title + '</div>';
            if (sortedEntries.length) {
              html += sortedEntries.map(function(e){
                const selfCls = (e.login===currentLogin ? ' self' : '');
                const gcls = ' g-' + genderCodeToClass(e.gender || 'X');
                return '<div class="msg' + selfCls + gcls + '\">' + renderUserHTML(e.login) + '</div>';
              }).join('');
            } else {
              html += '<div class="msg">' + (Array.isArray(list) ? '' : (list ?? '')) + '</div>';
            }
            panel.innerHTML = html;
            // Do not auto-switch to the Users tab here; keep focus on the current room.
          } catch(e) {
            // fallback to debug
            debugLog('Users in room: ' + json.list + '\n');
          }
        }

        if (json.type === 'listAllUsers'){
          try {
            const panel = document.getElementById('usersListPanel');
            const list = json.list;
            const title = 'Utilisateurs connectés';
            let html = '<div class="small muted">' + title + '</div>';
            let entries = [];
            if (Array.isArray(list)) {
              if (list.length && typeof list[0] === 'object') {
                entries = list.map(function(o){ return {login: o.login, gender: o.gender || 'X'}; });
              } else {
                entries = list.map(function(u){ return {login: u, gender: userGenders.get(u) || 'X'}; });
              }
            }
            // Update gender map
            entries.forEach(function(e){ if (e && e.login) userGenders.set(e.login, e.gender || 'X'); });
            // Apply sorting by gender then name
            const sorted = sortEntriesByGenderThenName(entries.slice());
            if (sorted.length) {
              html += sorted.map(function(e){
                const selfCls = (e.login===currentLogin ? ' self' : '');
                const gcls = ' g-' + genderCodeToClass(e.gender || 'X');
                return '<div class="msg' + selfCls + gcls + '\">' + renderUserHTML(e.login) + '</div>';
              }).join('');
            } else {
              html += '<div class="msg">' + (list ?? '') + '</div>';
            }
            panel.innerHTML = html;
            activateTabByTarget('panel-users');
          } catch(e) {
            debugLog('List of all users: ' + json.list + '\n');
          }
        }

        if (json.type === 'userInRoom'){
          appendMessage('currentRoomMessages', '[JOIN] ' + json.user + ' a rejoint ' + json.room, {system: true});
          if (json.user && json.gender) {
            try { userGenders.set(json.user, json.gender || 'X'); } catch(_){}
          }
          if (json.room && json.room === currentRoomName && json.user){
            currentRoomUsers.add(json.user);
            renderCurrentRoomUsers();
          }
        }

        if (json.type === 'userOutRoom'){
          appendMessage('currentRoomMessages', '[QUIT] ' + json.user + ' a quitté ' + json.room, {system: true});
          if (json.room && json.room === currentRoomName && json.user){
            currentRoomUsers.delete(json.user);
            renderCurrentRoomUsers();
          }
        }

        if (json.type === 'roomsList'){
          try {
            const rooms = json.rooms || {};
            // Sort by population (count) descending
            const entries = Object.entries(rooms).sort(function(a,b){ return (b[1]|0) - (a[1]|0); });
            const html = entries.length
              ? entries.map(([name, count]) => '<div class="msg room-item" data-room="' + name + '"><span class="meta">' + name + '</span> (<span class="room-count">' + count + '</span>)</div>').join('')
              : '<div class="muted small">Aucun salon</div>';
            document.getElementById('roomsListPanel').innerHTML = html;
            activateTabByTarget('panel-rooms');
          } catch (e) {
            document.getElementById('roomsListPanel').innerHTML = '<div class="muted small">Rooms list: [invalid payload]</div>';
          }
        }
      };
      reader.readAsText(data);
    }
  });
  // Emoji picker logic
  (function(){
    const EMOJIS = [
      '😀','😄','😅','😂','😊','😍','😘','😎','🤗','🤩',
      '🤔','🙃','😉','😜','🥳','👍','👏','🔥','❤️','🎉'
    ];
    const popup = document.getElementById('emojiPopup');
    const grid = document.getElementById('emojiGrid');
    let anchorBtn = null;
    let targetInput = null;

    function populate(){
      if (!grid) return;
      grid.innerHTML = EMOJIS.map(function(emo){
        return '<div class="item" data-emo="' + emo + '" title="' + emo + '"><div class="emo">' + emo + '</div></div>';
      }).join('');
    }

    function insertAtCaret(input, text){
      try {
        const start = input.selectionStart || 0;
        const end = input.selectionEnd || 0;
        const v = input.value || '';
        input.value = v.slice(0, start) + text + v.slice(end);
        const pos = start + text.length;
        input.focus();
        input.setSelectionRange && input.setSelectionRange(pos, pos);
      } catch(_){ input.value += text; try{ input.focus(); }catch(_){} }
    }

    function positionPopup(){
      if (!popup || !anchorBtn) return;
      const r = anchorBtn.getBoundingClientRect();
      const left = Math.min(window.innerWidth - popup.offsetWidth - 8, Math.max(8, r.left));
      let top = r.bottom + 6;
      if (top + popup.offsetHeight + 8 > window.innerHeight) {
        top = Math.max(8, r.top - popup.offsetHeight - 6);
      }
      popup.style.left = left + 'px';
      popup.style.top = Math.max(8, top) + 'px';
    }

    function openFor(btn, input){
      anchorBtn = btn; targetInput = input;
      populate();
      popup.classList.add('open');
      positionPopup();
      // Simple focus management: keep focus in input for typing continuity
      try { input && input.focus(); } catch(_){ }
    }
    function close(){
      popup.classList.remove('open');
      anchorBtn = null; targetInput = null;
    }
    function toggleFor(btn, input){
      if (popup.classList.contains('open') && anchorBtn === btn) { close(); }
      else { openFor(btn, input); }
    }

    // Click handler on emoji button (room)
    (function(){
      const btn = document.getElementById('roomEmojiBtn');
      const input = document.getElementById('roomInput');
      if (btn && input){
        btn.addEventListener('click', function(e){
          e.preventDefault();
          toggleFor(btn, input);
        });
      }
    })();

    // Delegate clicks on emojis
    if (grid){
      grid.addEventListener('click', function(e){
        const item = e.target.closest('.item');
        if (!item || !grid.contains(item)) return;
        const emo = item.getAttribute('data-emo');
        if (!emo) return;
        if (targetInput) insertAtCaret(targetInput, emo);
        // Close after selection
        close();
      });
    }

    // Close on outside click
    document.addEventListener('mousedown', function(e){
      if (!popup.classList.contains('open')) return;
      const isBtn = !!(anchorBtn && (e.target === anchorBtn || (anchorBtn.contains && anchorBtn.contains(e.target))));
      const isInside = popup.contains(e.target);
      if (!isBtn && !isInside) close();
    });

    // Close on Escape
    window.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && popup.classList.contains('open')) { close(); }
    });

    // Reposition when viewport changes
    window.addEventListener('resize', function(){ if (popup.classList.contains('open')) positionPopup(); });
    window.addEventListener('scroll', function(){ if (popup.classList.contains('open')) positionPopup(); }, true);
  })();

  function setUsersTabCount(count){
    const btn = getTabButtonByTarget('panel-users');
    if(!btn) return;
    const base = 'Connectés';
    if(typeof count === 'number' && isFinite(count)){
      btn.textContent = base + ' (' + count + ')';
    } else {
      btn.textContent = base;
    }
  }
</script>
{% endblock %}
