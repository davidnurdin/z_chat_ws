{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
  /* Full-viewport app layout */
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body { font: 16px/1.4 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
  .chat-wrapper {
    margin: 0; max-width: none; width: 100vw; height: calc(100vh - var(--sf-toolbar-height, 0px));
    display: flex; flex-direction: column;
  }
  /* iOS/WebKit fill-available fallback to keep wrapper pinned to viewport */
  @supports (-webkit-touch-callout: none) {
    html, body, .chat-wrapper { height: -webkit-fill-available; }
  }
  .controls { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; padding: .5rem; }
  .controls input[type=text] { padding: .4rem .6rem; border: 1px solid #ccc; border-radius: 6px; }
  .controls input[type=button] { padding: .45rem .7rem; border: 1px solid #bbb; background: #f8f8f8; border-radius: 6px; cursor: pointer; }
  .controls input[type=button]:hover { background: #efefef; }

  /* Tabs */
  .tabs { position: relative; border-bottom: 1px solid #ddd; display: flex; gap: 4px; overflow-x: auto; overflow-y: hidden; padding: .25rem .5rem; min-height: 44px; flex-shrink: 0; flex: 1 1 auto; min-width: 0; }
  .tab { appearance: none; background: #f2f2f2; border: 1px solid #ddd; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: .5rem .75rem; cursor: pointer; }
  .tab.active { background: white; border-color: #ccc; font-weight: 600; }
  .tab.closeable { position: relative; padding-right: 2.2rem; }
  .tab .close { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); color: #666; cursor: pointer; font-weight: 700; line-height: 1; width: 1.4rem; height: 1.4rem; display: flex; align-items: center; justify-content: center; border-radius: 999px; }
  .tab .close:hover { background: rgba(0,0,0,0.08); color: #111; }
  /* Theme toggle button pinned to right edge */
  #themeToggle {
    border: 1px solid #cbd5e1; background: #f8fafc; color: #0f172a;
    border-radius: 999px; padding: .2rem .5rem; cursor: pointer; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center; min-width: 2rem; min-height: 2rem;
    box-shadow: 0 1px 0 rgba(0,0,0,0.04);
  }
  #themeToggle:hover { background: #eef2f7; }
  #themeToggle:active { transform: scale(.98); }
  #themeToggle:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(59,130,246,.35); }
  /* Tabs + theme toggle on same row; no overlap */
  .tabs-line { display: flex; align-items: center; gap: .5rem; }
  .theme-bar { display: flex; justify-content: flex-end; padding: .25rem .5rem; flex: 0 0 auto; }
  /* Flashing attention state for tabs */
  .tab.notify { animation: tab-flash 1.2s ease-in-out infinite; border-color: #eab308; }
  @keyframes tab-flash { 0% { background: #fff59d; } 50% { background: #ffec82; } 100% { background: #fff59d; } }

  /* Mobile members icon in current room tab */
  #tab-current-room .mobile-users-icon {
    display: none;
    margin-left: .5rem;
    cursor: pointer;
    user-select: none;
    padding: 0;
    border: 1px solid #c7d2fe;
    background: #eef2ff;
    color: #1d4ed8;
    border-radius: 999px;
    line-height: 1;
    box-shadow: 0 1px 0 rgba(0,0,0,0.03);
    font-weight: 600;
  }
  #tab-current-room .mobile-users-icon:hover { background: #e0e7ff; border-color: #a5b4fc; }
  #tab-current-room .mobile-users-icon:active { transform: translateY(1px); }
  #tab-current-room .mobile-users-icon:focus { outline: none; }
  #tab-current-room .mobile-users-icon:focus-visible { box-shadow: 0 0 0 3px rgba(59,130,246,.35); }

  /* Fullscreen mobile users modal */
  #mobileUsersModal { position: fixed; inset: 0; background: #fff; z-index: 9998; display: none; flex-direction: column; }
  #mobileUsersModal.open { display: flex; }
  #mobileUsersModal .hdr { display: flex; align-items: center; justify-content: space-between; padding: .75rem 1rem; border-bottom: 1px solid #eee; font-weight: 600; }
  #mobileUsersModal .close { font-size: 1.4rem; line-height: 1; cursor: pointer; padding: .25rem .5rem; border-radius: 8px; }
  #mobileUsersModal .close:hover { background: #f3f4f6; }
  #mobileUsersContainer { flex: 1; min-height: 0; overflow-y: auto; padding: .5rem; }

  /* Panels container fills remaining space */
  .panels { border: 1px solid #ccc; border-radius: 0 8px 8px 8px; background: white; padding: .5rem; flex: 1; min-height: 0; display: flex; overflow: hidden; }
  .panel { display: none; width: 100%; height: 100%; }
  .panel.active { display: block; }
  .gated { display: none !important; }

  /* Current room layout (fills height) */
  #panel-current.panel.active { display: flex; flex-direction: column; }
  .current-room { display: flex; gap: .75rem; flex: 1; min-height: 0; }
  .current-room .left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .current-room .right { width: 240px; border-left: 1px solid #eee; padding-left: .5rem; display: flex; flex-direction: column; min-height: 0; }
  .current-room .right .users { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }
  .current-room .title { font-weight: 600; margin-bottom: .25rem; }

  /* Rooms layout (fills height) */
  #panel-rooms.panel.active { display: flex; flex-direction: column; }
  .rooms-layout { display: flex; gap: .75rem; flex: 1; min-height: 0; }
  .rooms-layout .left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rooms-layout .right { width: 260px; border-left: 1px solid #eee; padding-left: .5rem; display: flex; flex-direction: column; }
  .rooms-layout .right .box { border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }

  /* Users panel full height */
  #panel-users.panel.active { display: flex; flex-direction: column; }

  /* Private panels full height */
  .panel[id^="panel-private-"].panel.active { display: flex; flex-direction: column; }

  /* Make rooms clickable */
  #roomsListPanel .room-item { cursor: pointer; }

  .messages { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; padding: .5rem; background: #fafafa; }
  .msg { margin: .25rem 0; padding: .2rem .35rem; border-radius: 4px; transition: background-color .15s ease, color .15s ease; }
  .msg:hover { background: #f0f2f5; }
  /* Contextual hover colors */
  .msg.system:hover { background: #fee2e2; } /* light red for system */
  .msg.g-m:hover { background: #dbeafe; } /* light blue for Homme */
  .msg.g-f:hover { background: #fde2f2; } /* light pink for Femme */
  .msg.g-x:hover { background: #f7f7d1; } /* light yellow/green for Autre */
  .msg.self { font-weight: 700; }
  .msg.system { color: #b91c1c; font-weight: 700; }
  .msg .meta { color: #666; font-size: .85em; }
  #usersListPanel .msg,
  #currentRoomUsers .msg,
  #currentRoomMessages .msg { cursor: pointer; }

  /* Colored username tags */
  .user-tag { font-weight: inherit; }
  .user-tag.m { color: #2563eb; }
  .user-tag.f { color: #ec4899; }
  .user-tag.x { color: #a3a312; }
  /* Rooms count style */
  .room-count { color: #b91c1c; font-weight: 600; }

  .composer { --composer-h: 42px; display: flex; align-items: stretch; gap: .5rem; margin-top: .5rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: .4rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
  .composer textarea, .composer input[type=text] { flex: 1; border: none; outline: none; padding: 0 .65rem; border-radius: 8px; background: #f9fafb; resize: none; max-height: 140px; height: var(--composer-h); min-height: var(--composer-h); line-height: 1.3; }
  .composer textarea:focus, .composer input[type=text]:focus { background: #f3f4f6; }
  .composer .send-btn { appearance: none; border: none; background: #2563eb; color: #fff; padding: 0 .9rem; border-radius: 8px; cursor: pointer; font-weight: 600; min-width: 48px; display: inline-flex; align-items: center; justify-content: center; height: var(--composer-h); min-height: var(--composer-h); }
  .composer .send-btn:hover { background: #1d4ed8; }
  .composer .send-btn:active { transform: translateY(1px); }
  .composer .emoji-btn { appearance: none; border: 1px solid #e5e7eb; background: #f3f4f6; color: #111; padding: 0 .7rem; border-radius: 8px; cursor: pointer; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; height: var(--composer-h); min-height: var(--composer-h); }
  .composer .emoji-btn:hover { background: #e5e7eb; }
  .emoji-popup { position: fixed; z-index: 9999; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; box-shadow: 0 10px 24px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.08); padding: .5rem; width: 260px; display: none; }
  .emoji-popup.open { display: block; }
  .emoji-popup .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; }
  .emoji-popup .item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem; padding: .35rem; border-radius: 8px; cursor: pointer; user-select: none; border: 1px solid transparent; }
  .emoji-popup .item:hover { background: #f3f4f6; border-color: #e5e7eb; }
  .emoji-popup .emo { font-size: 20px; line-height: 1; }
  .emoji-popup .sc { font-size: 11px; color: #6b7280; }

  .muted { color: #6b7280; }
  .small { font-size: .85em; }

  /* Debug panel full height */
  #panel-infos.panel.active { display: flex; flex-direction: column; }
  .debug { width: 100%; flex: 1; min-height: 0; }
  /* Mobile responsiveness */
  @media (max-width: 900px) {
    body { font-size: 15px; }
    .controls { padding: .5rem; gap: .4rem; }
    .tab { padding: .5rem .6rem; }
    /* Hide the sidebar users list on mobile; it will be shown via popup */
    #panel-current .current-room .right { display: none !important; }
    .rooms-layout { flex-direction: column; }
    .rooms-layout .right { width: auto; border-left: none; border-top: 1px solid #eee; padding-left: 0; padding-top: .5rem; }
    .composer { gap: .4rem; }
    .messages { padding: .4rem; }
    /* Show the members icon inside the current room tab on mobile */
    #tab-current-room .mobile-users-icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; gap: .2rem; font-size: 14px; }
  }
  /* Prefer dynamic viewport on mobile UAs that support it */
  @supports (height: 100dvh) {
    .chat-wrapper { height: calc(100dvh - var(--sf-toolbar-height, 0px)); }
  }

  /* Prominent Snapchat-like connect button */
  #btn1 {
    --cta-delay: 8s; /* delay before attention animation starts */
    font-weight: 800;
    color: #111;
    background: #FFFC00; /* Snapchat yellow */
    border: 1px solid #e5e105;
    border-radius: 999px;
    padding: .55rem 1rem;
    box-shadow: 0 2px 0 rgba(0,0,0,0.08), 0 0 0 0 rgba(245, 208, 66, 0.0);
  }
  #btn1:hover { filter: brightness(0.95); }
  #btn1:active { transform: translateY(1px); }
  #btn1:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: #f3f4f6;
    color: #6b7280;
    border-color: #e5e7eb;
    box-shadow: none;
  }

  /* Attention animation after a few seconds when enabled */
  #btn1:not(:disabled) {
    animation: cta-pulse 1.6s ease-in-out infinite;
    animation-delay: var(--cta-delay, 8s);
  }
  #btn1:not(:disabled):hover,
  #btn1:not(:disabled):focus,
  #btn1:not(:disabled):active {
    animation-play-state: paused; /* stop pulsing when user interacts */
    outline: none;
  }
  #btn1:focus-visible {
    box-shadow: 0 0 0 3px rgba(59,130,246,.35), 0 2px 0 rgba(0,0,0,0.08);
  }
  @keyframes cta-pulse {
    0% { transform: translateY(0) scale(1); box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.0); }
    50% { transform: translateY(0) scale(1.035); box-shadow: 0 0 0 10px rgba(250, 204, 21, 0.25); }
    100% { transform: translateY(0) scale(1); box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.0); }
  }

  /* Respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #btn1:not(:disabled) { animation: none; }
  }

  /* Dark theme overrides */
  :root[data-theme="dark"] body { background: #0b1220; color: #e5e7eb; }
  :root[data-theme="dark"] .tabs { border-bottom-color: #334155; background: #0b1220; }
  :root[data-theme="dark"] .tab { background: #0f172a; border-color: #334155; color: #e5e7eb; }
  :root[data-theme="dark"] .tab.active { background: #111827; border-color: #475569; color: #fff; }
  :root[data-theme="dark"] #themeToggle { border-color: #475569; background: #0f172a; color: #e5e7eb; }
  :root[data-theme="dark"] #themeToggle:hover { background: #111827; }

  :root[data-theme="dark"] .panels { border-color: #334155; background: #0f172a; }
  :root[data-theme="dark"] .panel { color: #e5e7eb; }
  :root[data-theme="dark"] .messages { background: #0b1220; border-color: #334155; }
  :root[data-theme="dark"] .msg { color: #e5e7eb; }
  :root[data-theme="dark"] .msg:hover { background: #111827; }
  :root[data-theme="dark"] .msg.system { color: #f87171; }
  :root[data-theme="dark"] .msg .meta { color: #94a3b8; }

  :root[data-theme="dark"] .current-room .right { border-left-color: #334155; }
  :root[data-theme="dark"] .current-room .right .users { background: #0b1220; border-color: #334155; }
  :root[data-theme="dark"] .rooms-layout .right .box { background: #0b1220; border-color: #334155; }

  :root[data-theme="dark"] .controls input[type=text] { background: #0b1220; color: #e5e7eb; border-color: #334155; }
  :root[data-theme="dark"] .controls input[type=button] { background: #111827; color: #e5e7eb; border-color: #334155; }
  :root[data-theme="dark"] .controls input[type=button]:hover { background: #0f172a; }

  :root[data-theme="dark"] .composer { background: #0b1220; border-color: #334155; box-shadow: none; }
  :root[data-theme="dark"] .composer input[type=text] { background: #0b1220; color: #e5e7eb; border: 1px solid #334155; }
  /* Dark: Créer un salon (rooms panel) inputs/buttons */
  :root[data-theme="dark"] #panel-rooms .right .box input[type=text] { background: #0b1220; color: #e5e7eb; border: 1px solid #334155; }
  :root[data-theme="dark"] #panel-rooms .right .box input[type=text]::placeholder { color: #64748b; }
  :root[data-theme="dark"] #panel-rooms .right .box input[type=button] { background: #111827; color: #e5e7eb; border: 1px solid #334155; }
  :root[data-theme="dark"] #panel-rooms .right .box input[type=button]:hover { background: #0f172a; }
  :root[data-theme="dark"] .emoji-btn { background: #111827; color: #e5e7eb; border-color: #334155; }
  :root[data-theme="dark"] .send-btn { background: #111827; color: #e5e7eb; border-color: #334155; }

  :root[data-theme="dark"] .small.muted { color: #94a3b8; }

  :root[data-theme="dark"] #emojiPopup, :root[data-theme="dark"] #colorPopup {
    background: #0f172a; border-color: #334155; color: #e5e7eb;
  }
  :root[data-theme="dark"] #emojiPopup .grid button,
  :root[data-theme="dark"] #colorPopup .grid button { background: #111827; border-color: #334155; color: #e5e7eb; }
  :root[data-theme="dark"] #emojiPopup .grid button:hover,
  :root[data-theme="dark"] #colorPopup .grid button:hover { background: #0b1220; }

  :root[data-theme="dark"] #mobileUsersModal { background: #0f172a; color: #e5e7eb; }
  :root[data-theme="dark"] #mobileUsersModal .hdr { border-bottom-color: #334155; }
  :root[data-theme="dark"] #mobileUsersModal .close:hover { background: #111827; }

  :root[data-theme="dark"] .room-count { color: #fb7185; }

  /* Dark mode: improve tab notification visibility */
  :root[data-theme="dark"] .tab.notify {
    animation: tab-flash-dark 1.1s ease-in-out infinite;
    border-color: #f59e0b; /* amber-500 */
    color: #fff;
  }
  :root[data-theme="dark"] .tab.active.notify {
    border-color: #f59e0b;
  }
  @keyframes tab-flash-dark {
    0% { background: #7c2d12; box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.0); }
    50% { background: #b45309; box-shadow: 0 0 0 6px rgba(245, 158, 11, 0.25); }
    100% { background: #7c2d12; box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.0); }
  }

</style>

<div class="chat-wrapper">
  <div class="controls">
    <input type="text" id="login" value="" placeholder="login" />
    <label><input type="radio" name="gender" value="H"> <span class="user-tag m">H</span></label>
    <label><input type="radio" name="gender" value="F"> <span class="user-tag f">F</span></label>
    <label><input type="radio" name="gender" value="X" checked> <span class="user-tag x">X</span></label>
    <input type="button" id="btn1" value="Se connecter" onclick="authenticate()" disabled>
  </div>

  <div class="tabs-line">
    <div class="tabs" id="tabs">
      <button class="tab active" data-target="panel-infos">Infos</button>
      <button class="tab gated" data-target="panel-users">Connectés</button>
      <button class="tab gated" data-target="panel-rooms">Salons</button>
      <button class="tab gated" data-target="panel-current" id="tab-current-room"><span id="tab-current-room-label">-</span><span id="mobileUsersIcon" class="mobile-users-icon" title="Membres" aria-label="Membres" role="button" aria-haspopup="dialog" tabindex="0">👥</span></button>
      <!-- Private tabs will be appended here -->
    </div>
    <div class="theme-bar"><button id="themeToggle" title="Basculer thème" aria-label="Basculer thème">🌓</button></div>
  </div>
  <div class="panels">
    <div class="panel gated" id="panel-users">
      <div id="usersListPanel" class="messages"></div>
    </div>

    <div class="panel gated" id="panel-rooms">
      <div class="rooms-layout">
        <div class="left">
          <div class="small muted">Liste des salons</div>
          <div id="roomsListPanel" class="messages"></div>
        </div>
        <div class="right">
          <div class="small muted">Créer un salon</div>
          <div class="box">
            <input type="text" id="createRoomName" placeholder="Nom du salon" onkeypress="if(event.key==='Enter'){ const v=this.value.trim(); if(v){ enterRoom(v); this.value=''; }}" />
            <input type="button" value="Créer" onclick="(function(){ const el=document.getElementById('createRoomName'); const v=(el.value||'').trim(); if(v){ enterRoom(v); el.value=''; } })()">
            <div class="small muted" style="margin-top:.5rem;">Astuce: créer = entrer dans un salon nouveau.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel gated" id="panel-current">
      <div class="current-room">
        <div class="left">
          <div class="title small muted">Messages du salon</div>
          <div class="messages" id="currentRoomMessages"></div>
          <div class="composer" id="roomComposer">
            <input type="text" id="roomInput" placeholder="Votre message au salon en cours..." onkeydown="if(event.key==='Enter'){ event.preventDefault(); sendFromComposer(this,'room'); }" />
            <button type="button" class="emoji-btn" id="roomEmojiBtn" title="Insérer un emoji">:-)</button>
            <button type="button" class="emoji-btn color-btn" id="roomColorBtn" title="Couleur du message" aria-label="Couleur du message" style="--clr:#000000; background: var(--clr); color: #000; border:1px solid #e5e7eb;">■</button>
            <button class="send-btn" title="Envoyer" onclick="sendFromComposer(document.getElementById('roomInput'),'room')">-&gt;</button>
          </div>
        </div>
        <div class="right">
          <div class="title small muted">Connectés au salon</div>
          <div id="currentRoomUsers" class="users"></div>
        </div>
      </div>
    </div>

    <div class="panel active" id="panel-infos">
      <div class="small muted">Informations / Debug</div>
      <div id="debugMessages" class="messages"></div>
      <div id="lastPingLine" class="small muted" style="margin-top:.25rem;"></div>
    </div>

    <!-- Private panels will be appended here -->
    </div>
</div>

<!-- Emoji picker popup -->
<div id="emojiPopup" class="emoji-popup" role="dialog" aria-label="Sélecteur d'emoji" aria-modal="false">
  <div class="grid" id="emojiGrid"></div>
</div>
<!-- Color picker popup -->
<div id="colorPopup" class="emoji-popup" role="dialog" aria-label="Palette de couleurs" aria-modal="false">
  <div class="grid" id="colorGrid"></div>
</div>

<!-- Mobile users modal -->
<div id="mobileUsersModal" aria-hidden="true" role="dialog" aria-label="Connectés au salon">
  <div class="hdr">
    <div>Connectés au salon</div>
    <span id="mobileUsersClose" class="close" aria-label="Fermer">×</span>
  </div>
  <div id="mobileUsersContainer"></div>
</div>

<script>
  // Account for Symfony debug toolbar height and prevent page scroll
  (function initToolbarSizing(){
    function recalcToolbarInset(){
      try {
        var h = 0;
        var bs = getComputedStyle(document.body);
        var pad = parseInt(bs.paddingBottom, 10) || 0;
        var mar = parseInt(bs.marginBottom, 10) || 0;
        h = Math.max(h, pad, mar);
        var sf = document.querySelector('div[id^="sfwdt"]');
        if (sf && sf.offsetHeight) h = Math.max(h, sf.offsetHeight);
        document.documentElement.style.setProperty('--sf-toolbar-height', (h|0) + 'px');
      } catch(_) { /* noop */ }
    }
    window.addEventListener('load', recalcToolbarInset);
    window.addEventListener('resize', recalcToolbarInset);
    // Observe DOM changes that might affect toolbar size/visibility
    try {
      var mo = new MutationObserver(recalcToolbarInset);
      mo.observe(document.body, {attributes: true, childList: true, subtree: true});
    } catch(_) { /* older browsers */ }
    // Initial and short polling to catch first paint updates
    recalcToolbarInset();
    var ticks = 0; var iv = setInterval(function(){ recalcToolbarInset(); if(++ticks > 10) clearInterval(iv); }, 300);
  })();

  // Theme init and toggle
  (function initTheme(){
    var root = document.documentElement;
    var key = 'theme';
    var mql = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)')) || null;
    function systemMode(){ return mql && mql.matches ? 'dark' : 'light'; }
    function apply(mode){
      var m = (mode === 'dark') ? 'dark' : 'light';
      root.setAttribute('data-theme', m);
      var btn = document.getElementById('themeToggle');
