  function onSocketError(){
    appendMessage('debugMessages', 'Erreur de connexion WebSocket.', {system: true});
    notifyTab('panel-infos');
    try { if (pingWatchTimer) { clearInterval(pingWatchTimer); pingWatchTimer = null; } } catch(_){ }
    setConnectButtonEnabled(false);
    showLoginControls();
