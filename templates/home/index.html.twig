  // WebSocket connection with auto-reconnect and button gating
  let socket = null;
  const WS_URL = (window.location.protocol === 'https:' ? 'wss://' : 'ws://') + window.location.host + '/ws/chat';
  let reconnectTimer = null;
  // Heartbeat tracking for inactivity disconnect
  let lastFrameAt = Date.now();
  let pingWatchTimer = null;
  function startPingWatch(){
    try { if (pingWatchTimer) { clearInterval(pingWatchTimer); } } catch(_){ }
    pingWatchTimer = setInterval(function(){
      try {
        const now = Date.now();
        if (now - lastFrameAt > 60000) { // > 60 sec without any frame
          appendMessage('debugMessages', 'Connexion perdue: aucune trame reçue depuis plus de 60 secondes, déconnexion…', {system: true});
          notifyTab('panel-infos');
          try { socket && socket.close && socket.close(); } catch(_) {}
          try { if (pingWatchTimer) { clearInterval(pingWatchTimer); pingWatchTimer = null; } } catch(_){ }
          // Re-display login controls so user can reconnect (will also try to reopen WS)
          showLoginControls();
        }
      } catch(_) {}
    }, 10000);
  }
  function setConnectButtonEnabled(enabled){
    try { var b = document.getElementById('btn1'); if (b) b.disabled = !enabled; } catch(_){ }
  }
  function scheduleReconnect(){
    if (reconnectTimer) return;
    reconnectTimer = setInterval(function(){
      try {
        if (socket && (socket.readyState === 0 || socket.readyState === 1)) return; // connecting or open
      } catch(_){}
      try { connectSocket(); } catch(_){}
    }, 5000);
  }
  function clearReconnect(){
    try { if (reconnectTimer) { clearInterval(reconnectTimer); reconnectTimer = null; } } catch(_){ }
  }
  function onSocketOpen(){
    lastFrameAt = Date.now();
    debugLog('WebSocket connecté.\n');
    setConnectButtonEnabled(true);
    clearReconnect();
    startPingWatch();
